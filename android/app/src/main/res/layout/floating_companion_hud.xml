<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_hud_root"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:contentDescription="SYNTXRR Floating Companion HUD">

    <!-- Circular Bubble Container -->
    <FrameLayout
        android:id="@+id/floating_hud_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center">

        <!-- Center SYNTXRR App Icon -->
        <ImageView
            android:id="@+id/floating_hud_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="SYNTXRR Companion Icon" />

    </FrameLayout>

</FrameLayout>
