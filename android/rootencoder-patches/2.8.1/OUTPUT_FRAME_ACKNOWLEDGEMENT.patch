From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] RootEncoder 2.8.1: report per-target EGL output submission results

This patch reports makeCurrent, draw, presentation-time, and eglSwapBuffers
outcomes for STREAM and RECORD EGL targets. It does not claim MediaCodec
consumption or RTMP/network delivery.

diff --git a/encoder/src/main/java/com/pedro/encoder/input/gl/SurfaceManager.java b/encoder/src/main/java/com/pedro/encoder/input/gl/SurfaceManager.java
--- a/encoder/src/main/java/com/pedro/encoder/input/gl/SurfaceManager.java
+++ b/encoder/src/main/java/com/pedro/encoder/input/gl/SurfaceManager.java
@@ -60,18 +60,21 @@
     return true;
   }
 
-  public void swapBuffer() {
-    if (!EGL14.eglSwapBuffers(eglDisplay, eglSurface)) {
+  public boolean swapBuffer() {
+    boolean succeeded = EGL14.eglSwapBuffers(eglDisplay, eglSurface);
+    if (!succeeded) {
       Log.e(TAG, "eglSwapBuffers failed");
     }
+    return succeeded;
   }
 
   /**
    * Sends the presentation time stamp to EGL.  Time is expressed in nanoseconds.
    */
-  public void setPresentationTime(long nsecs) {
-    EGLExt.eglPresentationTimeANDROID(eglDisplay, eglSurface, nsecs);
+  public boolean setPresentationTime(long nsecs) {
+    boolean succeeded = EGLExt.eglPresentationTimeANDROID(eglDisplay, eglSurface, nsecs);
     GlUtil.checkEglError("eglPresentationTimeANDROID");
+    return succeeded;
   }
 
