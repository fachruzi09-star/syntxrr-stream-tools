+  private fun submitEncoderOutput(
+    target: EncoderOutputTarget,
+    manager: SurfaceManager,
+    sequence: Long,
+    timestamp: Long,
+    draw: () -> Unit
+  ) {
+    if (!manager.makeCurrent()) {
+      outputFrameCallback?.onOutputFrame(
+        OutputFrameResult(sequence, timestamp, target, false, false, false, false)
+      )
+      return
+    }
+    try {
+      draw()
+    } catch (error: Throwable) {
+      outputFrameCallback?.onOutputFrame(
+        OutputFrameResult(sequence, timestamp, target, true, false, false, false)
+      )
+      throw error
+    }
+    val presentationTimeAccepted = manager.setPresentationTime(timestamp)
+    val swapBuffersSucceeded = manager.swapBuffer()
+    outputFrameCallback?.onOutputFrame(
+      OutputFrameResult(
+        sequence, timestamp, target, true, true, presentationTimeAccepted, swapBuffersSucceeded
+      )
+    )
+  }
+
