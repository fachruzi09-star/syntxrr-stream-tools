+  private fun submitEncoderOutput(
+    target: EncoderOutputTarget,
+    manager: SurfaceManager,
+    width: Int,
+    height: Int,
+    orientation: Boolean,
+    timestamp: Long,
+    sequence: Long
+  ) {
+    var makeCurrentSucceeded = false
+    var drawSucceeded = false
+    var presentationTimeSucceeded = false
+    var eglSwapBuffersSucceeded = false
+    var errorMessage: String? = null
+    var renderException: RuntimeException? = null
+
+    try {
+      makeCurrentSucceeded = manager.makeCurrent()
+      if (!makeCurrentSucceeded) {
+        errorMessage = "eglMakeCurrent failed"
+      }
+    } catch (e: RuntimeException) {
+      renderException = e
+      errorMessage = e.message ?: e.javaClass.simpleName
+    }
+
+    if (makeCurrentSucceeded) {
+      try {
+        mainRender.drawScreenEncoder(
+          width,
+          height,
+          orientation,
+          streamOrientation,
+          isStreamVerticalFlip,
+          isStreamHorizontalFlip,
+          streamViewPort
+        )
+        drawSucceeded = true
+      } catch (e: RuntimeException) {
+        renderException = renderException ?: e
+        errorMessage = errorMessage ?: (e.message ?: e.javaClass.simpleName)
+      }
+
+      if (drawSucceeded) {
+        try {
+          presentationTimeSucceeded = manager.setPresentationTime(timestamp)
+          if (!presentationTimeSucceeded && errorMessage == null) {
+            errorMessage = "eglPresentationTimeANDROID failed"
+          }
+        } catch (e: RuntimeException) {
+          renderException = renderException ?: e
+          errorMessage = errorMessage ?: (e.message ?: e.javaClass.simpleName)
+        }
+
+        try {
+          eglSwapBuffersSucceeded = manager.swapBuffer()
+          if (!eglSwapBuffersSucceeded && errorMessage == null) {
+            errorMessage = "eglSwapBuffers failed"
+          }
+        } catch (e: RuntimeException) {
+          renderException = renderException ?: e
+          errorMessage = errorMessage ?: (e.message ?: e.javaClass.simpleName)
+        }
+      }
+    }
+
+    outputFrameCallback?.onOutputFrame(
+      OutputFrameResult(
+        target = target,
+        sequence = sequence,
+        presentationTimeNs = timestamp,
+        makeCurrentSucceeded = makeCurrentSucceeded,
+        drawSucceeded = drawSucceeded,
+        presentationTimeSucceeded = presentationTimeSucceeded,
+        eglSwapBuffersSucceeded = eglSwapBuffersSucceeded,
+        errorMessage = errorMessage
+      )
+    )
+
+    // Preserve the existing draw() error path after delivering the diagnostic result.
+    renderException?.let { throw it }
+  }
+
