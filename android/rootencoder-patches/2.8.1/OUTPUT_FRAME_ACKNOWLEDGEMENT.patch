+package com.pedro.library.view
+
+/** An EGL output attempt made by RootEncoder's GL render executor. */
+enum class EncoderOutputTarget {
+  STREAM,
+  RECORD
+}
+
+/**
+ * Per-target EGL submission result. A successful result means the render pass completed,
+ * eglPresentationTimeANDROID returned true, and eglSwapBuffers returned true. It does not
+ * mean MediaCodec consumed/encoded the buffer or that RTMP transmitted the resulting packet.
+ */
+data class OutputFrameResult(
+  val sequence: Long,
+  val presentationTimestampNanos: Long,
+  val target: EncoderOutputTarget,
+  val makeCurrentSucceeded: Boolean,
+  val drawSucceeded: Boolean,
+  val presentationTimeAccepted: Boolean,
+  val swapBuffersSucceeded: Boolean
+) {
+  val eglSubmissionSucceeded: Boolean
+    get() = makeCurrentSucceeded && drawSucceeded && presentationTimeAccepted && swapBuffersSucceeded
+}
+
+/** Invoked synchronously on RootEncoder's GL render executor; callbacks must be fast and non-blocking. */
+fun interface OutputFrameCallback {
+  fun onOutputFrame(result: OutputFrameResult)
+}
