+package com.pedro.library.view
+
+/**
+ * Identifies the EGL surface receiving an encoder frame.
+ */
+enum class EncoderOutputTarget {
+  STREAM,
+  RECORD
+}
+
+/**
+ * Reports the stages completed while submitting one rendered frame to an EGL output surface.
+ *
+ * A successful result confirms EGL submission only. It does not confirm MediaCodec consumption,
+ * encoded output availability, RTMP packet creation, or network delivery.
+ */
+data class OutputFrameResult(
+  val target: EncoderOutputTarget,
+  val sequence: Long,
+  val presentationTimeNs: Long,
+  val makeCurrentSucceeded: Boolean,
+  val drawSucceeded: Boolean,
+  val presentationTimeSucceeded: Boolean,
+  val eglSwapBuffersSucceeded: Boolean,
+  val errorMessage: String? = null
+) {
+  val eglSubmissionSucceeded: Boolean
+    get() = makeCurrentSucceeded &&
+      drawSucceeded &&
+      presentationTimeSucceeded &&
+      eglSwapBuffersSucceeded
+}
+
+/**
+ * Callback invoked on the GL rendering thread after an encoder-target submission attempt.
+ */
+fun interface OutputFrameCallback {
+  fun onOutputFrame(result: OutputFrameResult)
+}
